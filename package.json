{
  "name": "iron-veil-blood-circuit",
  "version": "1.0.0",
  "description": "IRON VEIL: BLOOD CIRCUIT - an original 2D fighting game (HTML5 Canvas + Web Audio).",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "start": "node serve.js",
    "test": "node tests/smoke.mjs && node tests/adventure_smoke.mjs",
    "desktop": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.4.11"
  },
  "build": {
    "appId": "com.ironveil.bloodcircuit",
    "productName": "IRON VEIL - BLOOD CIRCUIT",
    "win": {
      "target": "portable",
      "icon": "icon.ico"
    },
    "files": [
      "**/*",
      "!dist",
      "!out",
      "!tests",
      "!*.ps1",
      "!create_desktop_shortcut.mjs",
      "!generate_icon.mjs"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
